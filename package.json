{
  "name": "@maczen/monorepo",
  "private": true,
  "packageManager": "bun@1.2.21",
  "workspaces": [
    "apps/desktop-app-tauri",
    "apps/marketing-site"
  ],
  "scripts": {
    "dev": "./scripts/cleanup-ports.sh && cd apps/desktop-app-tauri && bun run dev",
    "dev:marketing-site": "./scripts/cleanup-ports.sh && bunx turbo run dev --filter='@maczen/marketing-site'",
    "dev:desktop-app": "./scripts/cleanup-ports.sh && bunx turbo run dev --filter='@maczen/desktop-app'",
    "dev:desktop-app-tauri": "bash ./scripts/dev-desktop-app-tauri.sh",
    "build": "bunx turbo run build",
    "lint": "bunx turbo run lint",
    "typecheck": "bunx turbo run typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bun": "latest",
    "concurrently": "^9.2.1",
    "turbo": "^2.5.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.2",
    "wait-on": "^9.0.1"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
