{
  "name": "@maczen/desktop-app-tauri",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "native-bridge:stage": "node ../../scripts/stage-native-bridge.mjs",
    "dev": "bun run native-bridge:stage && bunx concurrently -k \"bun run web:dev\" \"tauri dev --no-dev-server\"",
    "tauri:build": "bun run native-bridge:stage && tauri build",
    "web:dev": "vite --port 30232 --strictPort",
    "web:build": "vite build",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-popover": "^1.1.15",
    "@tauri-apps/api": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.562.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "ffmpeg-static": "^5.2.0",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.3.3",
    "vite": "^5.0.8"
  }
}
